APP_NAME=WellnessLog
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wellnesslog
DB_USERNAME=wellnesslog
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@wellnesslog.test"
MAIL_FROM_NAME="${APP_NAME}"

# Docker host port mappings
APP_PORT=8080
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

L5_SWAGGER_GENERATE_ALWAYS=false
